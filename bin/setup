#!/bin/bash
# Author: Vincent Wachira <vwachira@opencapital.com>
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 2
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 2
cd "$repo_root" || exit 2
[ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || {
  echo "setup unavailable: supported host is Darwin arm64" >&2; exit 2;
}
for prerequisite in curl tar shasum mktemp; do
  command -v "$prerequisite" >/dev/null || { echo "setup unavailable: missing prerequisite" >&2; exit 2; }
done
mkdir -p .tools || exit 2
scratch=$(mktemp -d "${TMPDIR:-/tmp}/gc-tool-setup.XXXXXX") || exit 2
trap 'rm -rf "$scratch"' EXIT
pin_tool() {
  local name="$1" digest="$2" archive_digest="$3" url="$4" member="$5"
  if [ -f ".tools/$name" ] && [ "$(shasum -a 256 ".tools/$name" | cut -d ' ' -f 1)" = "$digest" ]; then
    chmod 755 ".tools/$name" || exit 2
    return
  fi
  curl --proto '=https' --tlsv1.2 -fsSL --retry 2 --connect-timeout 20 --max-time 180 "$url" -o "$scratch/$name.tgz" || {
    echo "setup unavailable: pinned artifact download failed" >&2; exit 2;
  }
  if [ "$(shasum -a 256 "$scratch/$name.tgz" | cut -d ' ' -f 1)" != "$archive_digest" ]; then
    echo "setup unavailable: archive hash mismatch" >&2; exit 2;
  fi
  tar -xOf "$scratch/$name.tgz" "$member" > "$scratch/$name" || exit 2
  if [ "$(shasum -a 256 "$scratch/$name" | cut -d ' ' -f 1)" != "$digest" ]; then
    echo "setup unavailable: binary hash mismatch" >&2; exit 2;
  fi
  chmod 755 "$scratch/$name" || exit 2
  mv "$scratch/$name" ".tools/$name" || exit 2
}
pin_tool shellcheck 61c17246d69f012cd458ae82f244c46023dac75d1b69733ca1cc7d28fb270fd7 \
  339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f \
  https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.darwin.aarch64.tar.gz \
  shellcheck-v0.11.0/shellcheck
pin_tool gitleaks ba52fb1bfabbcde42f032afad3d6e0b19dff8ed105229a16e7caa338bbc0e84f \
  b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 \
  https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz \
  gitleaks
git config --local core.hooksPath .githooks || exit 2
echo "setup: verified release ShellCheck 0.11.0 and Gitleaks 8.30.1; local hooks configured"
